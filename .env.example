# StudyTrack Mobile App — Environment Variables
# Copy this file to .env and fill in your values.
# For the offline-first (default) configuration, no environment variables are required.
# The app uses SQLite local storage by default.

# ──────────────────────────────────────────────
# AI Tutor — Gemini Cloud API (Optional)
# Obtain your API key at: https://aistudio.google.com/app/apikey
# ──────────────────────────────────────────────
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# ──────────────────────────────────────────────
# AI Tutor — Alternative: OpenAI-compatible API
# ──────────────────────────────────────────────
# EXPO_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# ──────────────────────────────────────────────
# Build Configuration (Optional)
# ──────────────────────────────────────────────
# APP_VARIANT=development   # development | preview | production
# EAS_PROJECT_ID=your_eas_project_id_here
